# Copy to .env and paste your key from https://serpapi.com/manage-api-key
# Read by the Vite middleware in dev and by server.js in production; never shipped to the browser.
# On Render, set it under Environment instead of committing a .env.
SERPAPI_KEY=

# ElevenLabs voices for cutscenes, transmissions and MOONLINK (https://elevenlabs.io/app/settings/api-keys).
# Optional: override a voice with ELEVENLABS_VOICE_MOONLINK / _NARRATOR / _STRANGER / _MAYA / _OKORO / _LENA = <voice id>.
ELEVENLABS_API_KEY=
